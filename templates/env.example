# cog — environment template
#
# Copy to `.env` next to docker-compose.yml, fill in the marked values,
# then `docker compose up -d`.
#
#   cp env.example .env
#
# Everything commented out is optional. Everything uncommented needs a
# real value before cog will start.

# --- Telegram -------------------------------------------------------
# Token from @BotFather. Numeric user IDs allowed to talk to the bot
# (comma-separated) — get yours from @userinfobot. Leave ALLOWED_USER_IDS
# empty and the bot answers nobody, which is the safe default.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# --- Postgres -------------------------------------------------------
# Matches the bundled postgres service in docker-compose.yml. Point it
# at a managed instance if you'd rather not run one in-stack.
POSTGRES_URL=postgres://cog:cog@postgres:5432/cog?sslmode=disable

# --- Default model --------------------------------------------------
# Where new chats start. Switch at runtime with `/model use <name>` or
# `/provider use <name>` against any provider you've keyed below.
DEFAULT_MODEL=claude-sonnet-4-6
# Normally derived from DEFAULT_MODEL. Set explicitly only if the
# resolver picks the wrong provider for a custom model name.
# DEFAULT_PROVIDER=anthropic

# --- LLM API keys ---------------------------------------------------
# Bring your own, for any of the 8 supported providers. You need at
# least one. Cog never meters, marks up or proxies these — you pay the
# provider directly, and provider/model choice is never gated by tier.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# --- Cog home + identity --------------------------------------------
# Host path bind-mounted as the agent's home. Must match the volume in
# docker-compose.yml.
HOST_WORKSPACE=./workspace
# HOST_SCRATCH=./scratch
USER_EMAIL=you@example.com
# Cog's working directory inside the container.
WORKDIR=/workspace

# --- Discord (optional second channel) ------------------------------
# Uncomment the gateway-discord service in docker-compose.yml too.
# DISCORD_BOT_TOKEN=
# Restrict to specific guilds; empty = any guild the bot is invited to.
# DISCORD_GUILD_ALLOWLIST=

# --- Extension surfaces ---------------------------------------------
# Scanned at startup / first message. See AUTHORING.md for the gear
# schema and the agent frontmatter format.
COG_DECLARATIVE_GEARS_DIR=/root/.cog/gears
COG_AGENTS_DIR=/root/.cog/agents

# Permit Tier-1 declarative gears that declare allow_private_network to
# reach localhost / host.docker.internal / RFC1918 — the "wrap your own
# service" pattern in AUTHORING.md §6. Off by default. Link-local (cloud
# metadata) stays blocked either way.
# COG_DECLARATIVE_ALLOW_PRIVATE_NETWORK=true

# --- HTTP API (all tiers) -------------------------------------------
# Talk to cog programmatically instead of through a messaging app —
# POST /api/v1/chat with a Bearer token. Nothing transits a third party.
# COG_HTTP_API_ADDR=:8081
# COG_HTTP_API_TOKEN=

# --- Google Workspace (optional) ------------------------------------
# All four must be set together for the gmail / calendar / drive / sheets
# gears to wire up. Then run `/google connect` in Telegram.
# COG_GOOGLE_TOKEN_KEY encrypts each user's OAuth tokens at rest
# (AES-256-GCM); rotating it forces everyone to reconnect.
# COG_GOOGLE_CLIENT_ID=
# COG_GOOGLE_CLIENT_SECRET=
# COG_GOOGLE_SCOPES=
# COG_GOOGLE_TOKEN_KEY=

# --- Persona (optional) ---------------------------------------------
# System-prompt overlay applied every turn. Change at runtime with
# `/persona`.
# COG_PERSONA_NAME=
# COG_PERSONA_VOICE=
# COG_PERSONA_PRONOUNS=
# COG_PERSONA_PRESET=
# COG_PERSONA_CUSTOM=

# --- Memory embeddings ----------------------------------------------
# Persistent memory is pgvector-backed and embeds through Ollama. This
# is the EMBEDDINGS backend only — Ollama is not a chat-model provider
# in cog today. Defaults suit the bundled compose stack.
# OLLAMA_URL=http://host.docker.internal:11434
# EMBED_MODEL=nomic-embed-text

LOG_LEVEL=info

# --- Hardening ------------------------------------------------------
# All optional. Uncomment when you want the posture. Worth reading
# before exposing the bot to anyone but yourself.

# Refuse arbitrary Python/JS execution, local and provider-native.
# COG_DISABLE_CODE_EXEC=true

# Program allowlist for subprocess-spawning gears. Despite the name
# these no longer gate a `bash` gear — there isn't one — they constrain
# which PROGRAMS gears like git and the language toolchains may invoke,
# matched by base name. With REQUIRE=true and an empty allowlist,
# every subprocess is refused rather than defaulting to unrestricted.
# COG_BASH_REQUIRE_ALLOWLIST=true
# COG_BASH_ALLOWLIST=git,go,python3,sh,pytest,pip

# Refuse requests when the per-user policy lookup errors (production
# posture). Default true.
# COG_POLICY_FAIL_CLOSED=true

# Trusted proxy CIDRs for X-Forwarded-For. Without this, XFF is IGNORED
# — the safe default when you're not behind a reverse proxy.
# COG_GATEWAY_TRUSTED_PROXIES=10.0.0.0/8

# Chain webhook receiver (Pro). Unset = webhook chains load but never fire.
# COG_CHAIN_WEBHOOK_ADDR=:9090

# --- Trajectory signing (audit deployments) -------------------------
# Ed25519 key, held OUTSIDE the database, that signs each trajectory
# head — this is what turns the audit trail from integrity-checked into
# tamper-evident against someone with database write access. Keep the
# freshness anchor on durable storage that attacker can't reach.
# COG_TRAJECTORY_SIGNING_KEY=/run/secrets/cog_trajectory_key
# COG_TRAJECTORY_VERIFY_KEY=/run/secrets/cog_trajectory_pub
# COG_TRAJECTORY_FRESHNESS_PATH=/var/lib/cog/freshness

# --- cog-master admin plane (Teams) ---------------------------------
# Only needed when running cog-master alongside for admin/audit UI.
# COG_MASTER_ADMIN_EMAILS=admin@example.com
# COG_MASTER_CSRF_SECRET=
# COG_MASTER_FORCE_SECURE_COOKIES=true
